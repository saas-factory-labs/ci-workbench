@page "/repo/{Owner}/{Name}"
@page "/repo/{Owner}/{Name}/failures"
@implements IDisposable
@inject AppSession Session
@inject InspectorState Inspector
@inject NavigationManager Nav
@inject WorkspaceSignals Signals

<PageTitle>@Owner/@Name · CIWorkbench</PageTitle>
<h1 class="sr-only">@Owner/@Name @(IsFailures ? "failure series" : "workflows")</h1>

<RepositoryWorkspace Repo="_repo" ShowSearch="false" View="@(IsFailures ? WorkspaceView.Failures : WorkspaceView.Groups)"
                     Description="@Info?.Description" DefaultBranch="@Info?.DefaultBranch"
                     SelectedRunId="Inspector.Selection?.Run.Id" MaxRuns="@(Session.Mode == DataMode.Demo ? 250 : 100)"
                     OnRunSelected="Inspector.Select" OnViewFailures="GoFailures">
    <HeaderActions>
        @if (SafeHttps(Info?.HtmlUrl) is { } url)
        {
            <a class="ciw-btn" href="@url" target="_blank" rel="noopener noreferrer"><Icon Name="github" Size="17" /> View on GitHub</a>
        }
        else if (Session.Mode == DataMode.Demo)
        {
            <span class="ciw-btn disabled" aria-disabled="true" title="Demo data: this repository does not exist on GitHub."><Icon Name="github" Size="17" /> View on GitHub</span>
        }
    </HeaderActions>
</RepositoryWorkspace>

@code {
    [Parameter] public string Owner { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    private RepoRef _repo;
    private bool IsFailures => Nav.Uri.TrimEnd('/').EndsWith("/failures", StringComparison.OrdinalIgnoreCase);
    private RepositoryInfo? Info => Session.Repositories.FirstOrDefault(r => r.Ref.Equals(_repo));

    protected override void OnInitialized() => Session.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        var next = new RepoRef(Owner, Name);
        if (!next.Equals(_repo)) { _repo = next; Inspector.Clear(); Signals.SetSearch(null); Session.Select(next); }
    }

    private void GoFailures() => Nav.NavigateTo($"repo/{Owner}/{Name}/failures");
    private static string? SafeHttps(string? u) => Uri.TryCreate(u, UriKind.Absolute, out var x) && x.Scheme == Uri.UriSchemeHttps && !x.Host.EndsWith(".invalid") ? x.ToString() : null;
    public void Dispose() => Session.Changed -= OnChanged;
}
