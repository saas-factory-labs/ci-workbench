@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

<nav class="sidebar" aria-label="Main" data-collapsed="@(Collapsed ? "true" : "false")">
    <a class="nav @Cls(Section.Overview)" href="overview" aria-current="@Current(Section.Overview)" title="@Tip("Overview")" aria-label="@Aria("Overview")"><Icon Name="home" Size="19" /><span class="nav-label">Overview</span></a>
    <a class="nav @Cls(Section.Repositories)" href="repositories" aria-current="@Current(Section.Repositories)" title="@Tip("Repositories")" aria-label="@Aria("Repositories")"><Icon Name="repo" Size="19" /><span class="nav-label">Repositories</span> <span class="ciw-count">@Session.Repositories.Count@(Session.Discovery == DiscoveryState.Running ? "+" : "")</span></a>
    <a class="nav @Cls(Section.Groups)" href="@GroupsHref" aria-current="@Current(Section.Groups)" title="@Tip("Workflow Groups")" aria-label="@Aria("Workflow Groups")"><Icon Name="layers" Size="19" /><span class="nav-label">Workflow Groups</span></a>
    <a class="nav @Cls(Section.Failures)" href="@FailuresHref" aria-current="@Current(Section.Failures)" title="@Tip("Failure Series")" aria-label="@Aria("Failure Series")"><Icon Name="shield-alert" Size="19" /><span class="nav-label">Failure Series</span></a>
    <a class="nav @Cls(Section.Settings)" href="settings" aria-current="@Current(Section.Settings)" title="@Tip("Settings")" aria-label="@Aria("Settings")"><Icon Name="sliders" Size="19" /><span class="nav-label">Settings</span></a>
    @if (Recents.Count > 0)
    {
        <div class="recent-list">
            <h6>Recent repositories</h6>
            @foreach (var r in Recents)
            {
                <a class="recent" href="repo/@r.Owner/@r.Name" title="@r.FullName"><Icon Name="repo" Size="16" /> <span>@r.Name</span></a>
            }
            <a class="all-repos" href="repositories">All repositories →</a>
        </div>
    }
</nav>

@code {
    private enum Section { None, Overview, Repositories, Groups, Failures, Settings }

    /// <summary>Icon-only mode: labels stay in the DOM (visually hidden) and every item gets a tooltip.</summary>
    [Parameter] public bool Collapsed { get; set; }

    private const int MaxRecents = 4;

    /// <summary>The newest few repositories, without the one already shown in the top bar.</summary>
    private IReadOnlyList<RepoRef> Recents => Session.Recent.Where(r => !r.Equals(Session.Selected)).Take(MaxRecents).ToList();

    // Tooltips are always present: the sidebar also collapses on its own at narrow widths, where only icons remain visible.
    private static string Tip(string label) => label;
    private static string? Aria(string label) => null;

    private string GroupsHref => Session.Selected is { } s ? $"repo/{s.Owner}/{s.Name}" : "repositories";
    private string FailuresHref => Session.Selected is { } s ? $"repo/{s.Owner}/{s.Name}/failures" : "repositories";

    /// <summary>Exactly one primary item is active, derived from the URL.</summary>
    private Section Active
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            if (path.Length == 0) return Section.None;
            if (path.Equals("/overview", StringComparison.OrdinalIgnoreCase)) return Section.Overview;
            if (path.Equals("/repositories", StringComparison.OrdinalIgnoreCase)) return Section.Repositories;
            if (path.Equals("/settings", StringComparison.OrdinalIgnoreCase)) return Section.Settings;
            if (path.StartsWith("/repo/", StringComparison.OrdinalIgnoreCase)) return path.EndsWith("/failures", StringComparison.OrdinalIgnoreCase) ? Section.Failures : Section.Groups;
            return Section.None;
        }
    }

    private string Cls(Section s) => Active == s ? "active" : "";
    private string? Current(Section s) => Active == s ? "page" : null;

    private void OnChanged() => InvokeAsync(StateHasChanged);
    protected override void OnInitialized() { Session.Changed += OnChanged; Nav.LocationChanged += OnLocation; }
    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() { Session.Changed -= OnChanged; Nav.LocationChanged -= OnLocation; }
}
