<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0e1218" />
    <meta name="color-scheme" content="dark light" />
    <base href="/" />
    <script src="@Assets["_content/CIWorkbench.Components/ciw-theme.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/CIWorkbench.Components/ciworkbench.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="@Assets["ciworkbench-logo.svg"]" />
    <HeadOutlet @rendermode="NoPrerender" />
</head>

<body>
    <Routes @rendermode="NoPrerender" />
    <ReconnectModal />
    <script src="@Assets["_content/CIWorkbench.Components/ciworkbench.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Interactive Server without prerender: pages load data exactly once, after the circuit connects.
    private static readonly IComponentRenderMode NoPrerender = new InteractiveServerRenderMode(prerender: false);
}
