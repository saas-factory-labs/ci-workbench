@{
    var w = Assigned.Workflow;
    var runs = Ws.RunsFor(w);
    var open = Ws.WfOpen(w);
    var hasAnalysis = Ws.TryGetAnalysis(w.Path, out var analysis);
    var failures = runs.Count(r => r.State == RunState.Failure);
    var latestDone = runs.FirstOrDefault(r => r.State.IsCompleted());
    IReadOnlyList<JobInfo>? jobs = null;
    var hasJobs = latestDone is not null && Ws.TryGetJobs(latestDone.Id, out jobs);
    var tableFilter = new RunFilter(State: Ws.StatusFilter == "Failed" ? RunState.Failure : Ws.StatusFilter == "Succeeded" ? RunState.Success : null);
    var summary = RunSummary.From(runs);
}
<div class="ciw-wf @(open ? "open" : "")" data-workflow="@w.Path">
    <div class="ciw-wf-head" tabindex="0" role="button" aria-expanded="@(open ? "true" : "false")" @onclick="() => Ws.ToggleWorkflow(w)" @onkeydown="OnKey">
        <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="16" Class="ciw-chev" />
        <span class="ciw-wficon"><Icon Name="workflow" Size="18" /></span>
        <span class="ciw-wf-name">@w.Name</span>
        <span class="ciw-mono ciw-muted ciw-path">@w.Path</span>
        @if (!w.IsActive) { <span class="ciw-chip">disabled</span> }
        <span class="ciw-spacer"></span>
        @if (hasAnalysis && analysis!.Recurring.Count > 0) { <span class="ciw-chip bad" title="Recurring failure series">⚠ @analysis.Recurring.Count recurring</span> }
        <StatusIcon State="Ws.LatestState(w)" />
        <SuccessBar Rate="summary.SuccessRate" Scope="@Ws.ScopeText(summary)" />
        <span class="ciw-muted ciw-runs">@runs.Count @(runs.Count == 1 ? "run" : "runs")</span>
        <span class="ciw-muted ciw-ago">@Fmt.Ago(runs.FirstOrDefault()?.SortTime, Ws.Clock.GetUtcNow())</span>
    </div>
    @if (open)
    {
        <div class="ciw-wf-body">
            @if (hasAnalysis && analysis!.Series.Count > 0)
            {
                <section class="ciw-seriespanel" aria-label="Failure analysis">
                    <header>
                        <span class="ciw-shield"><Icon Name="shield-alert" Size="18" /></span>
                        <strong>Recurring failure series</strong>
                        <span class="ciw-count">@analysis.Recurring.Count</span>
                        <span class="ciw-muted ciw-sub">Consecutive failures with the same error pattern</span>
                        <span class="ciw-spacer"></span>
                        <span class="ciw-muted ciw-inspected">Inspected @analysis.RunsInspected of @analysis.RunsAvailable failed runs@(analysis.Truncated ? " · older failures not inspected" : "")</span>
                    </header>
                    <FailureSeriesList Repo="Ws.RepoRef" Series="analysis.Series" Runs="runs" OnRunSelected="Ws.Select" />
                </section>
            }
            else if (Ws.Analyzing && !hasAnalysis && failures >= 1)
            {
                <div class="ciw-notice info" role="status">Analyzing recent failures…</div>
            }
            @if (hasJobs && jobs is not null)
            {
                var okCount = jobs.Count(j => j.State == RunState.Success);
                var badCount = jobs.Count(j => j.State == RunState.Failure);
                <div class="ciw-jobchips" aria-label="Jobs of the latest completed run">
                    <span class="ciw-jobchips-label">Jobs <span class="ciw-muted">(latest run #@latestDone!.RunNumber)</span>
                        <span class="ciw-jobtally"><span class="ok">@okCount healthy</span>@if (badCount > 0) { <span class="bad"> · @badCount failing</span> }</span></span>
                    @foreach (var j in jobs.OrderByDescending(j => j.State == RunState.Failure).ThenBy(j => j.Name))
                    {
                        <button type="button" class="ciw-jobchip @Fmt.StateClass(j.State)" @onclick="() => Ws.Select(new RunSelection(Ws.RepoRef, latestDone, j.Name))" title="@j.Name: @Fmt.StateLabel(j.State), @Fmt.Duration(j.Duration). Open in inspector">
                            <StatusIcon State="j.State"/><span>@j.Name</span><span class="ciw-muted">@Fmt.Duration(j.Duration)</span>
                        </button>
                    }
                </div>
            }            <RunTable Runs="RunFiltering.Apply(Ws.VisibleRuns(w), tableFilter)" SelectedRunId="Ws.SelectedRun" OnRunSelected="Ws.SelectRun" HealthFor="@(hasAnalysis ? Health : null)" />
            @if (!Ws.HasHistory(w.Id) && runs.Count >= 5)
            {
                <div><button type="button" class="ciw-btn sm" @onclick="() => Ws.LoadHistoryAsync(w)">Load more history</button></div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] internal RepositoryWorkspace Ws { get; set; } = default!;
    [Parameter, EditorRequired] public AssignedWorkflow Assigned { get; set; } = default!;

    private void OnKey(KeyboardEventArgs e) { if (e.Key is "Enter" or " ") _ = Ws.ToggleWorkflow(Assigned.Workflow); }

    /// <summary>Health text only from jobs that were actually inspected; never inferred.</summary>
    private (string Text, string Cls)? Health(WorkflowRunInfo r)
    {
        if (!Ws.TryGetAnalysis(Assigned.Workflow.Path, out var a)) return null;
        var failed = a.Series.SelectMany(s => s.Occurrences).Where(o => o.Run.Id == r.Id).Select(o => o.JobName).Distinct().ToList();
        if (failed.Count > 0) return (failed.Count == 1 ? $"{failed[0]} failed" : $"{failed[0]} +{failed.Count - 1} failed", "bad");
        return r.State switch
        {
            RunState.Success => ("All jobs passed", "ok"),
            RunState.Failure => ("Not inspected", "muted"),
            _ => null,
        };
    }
}
