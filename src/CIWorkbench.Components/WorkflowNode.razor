@{
    var w = Assigned.Workflow;
    var runs = Ws.RunsFor(w);
    var open = Ws.WfOpen(w);
    var latest = runs.FirstOrDefault();
    var health = Ws.HealthOf(w);
    var now = Ws.Clock.GetUtcNow();
    var otherBranch = Ws.NonDefaultBranch(latest);
    var url = SafeUrl(w.HtmlUrl);
}
<div class="ciw-wf @(open ? "open" : "")" data-workflow="@w.Path" data-health="@health.Kind.ToString().ToLowerInvariant()">
    <div class="ciw-wf-head">
        <div class="ciw-wf-main">
            <button type="button" class="ciw-toggle ciw-wf-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="ciw-prev-@w.Id"
                    aria-label="@(open ? "Collapse" : "Expand") quick preview of @w.Name" title="@(open ? "Collapse" : "Expand") quick preview"
                    @onclick="() => Ws.ToggleWorkflow(w)">
                <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="16" Class="ciw-chev" />
            </button>
            <a class="ciw-wf-name" href="@Ws.RouteTable.Workflow(Ws.RepoRef, w.Id)" title="Open workflow details · @w.Path" data-action="open-workflow">@w.Name</a>
            <span class="ciw-flags">
                @if (!w.IsActive) { <span class="ciw-flag">disabled</span> }
                @if (health.Kind == HealthKind.FailingNow && health.Recurring && !health.Stale) { <span class="ciw-flag bad" title="The failure-series analysis found the same failure repeating">Recurring</span> }
                @if (health.Kind == HealthKind.FailingNow && health.Stale) { <span class="ciw-flag" title="The newest finished run failed @Fmt.Ago(health.Verdict!.SortTime, now); older than @((int)WorkflowHealthAnalyzer.StaleAfter.TotalDays) days, so not treated as a current incident">Stale · @Fmt.Ago(health.Verdict.SortTime, now)</span> }
                @if (health.Kind == HealthKind.FailingNow && !health.Stale && latest is { State: not RunState.Failure }) { <span class="ciw-flag bad" title="The newest run is @Fmt.StateLabel(latest.State), but the newest finished run failed">Failing now</span> }
                @if (health.Kind == HealthKind.Recovered) { <span class="ciw-flag good" title="Failed earlier; the newest finished run succeeded">Recovered</span> }
                @if (health.Kind == HealthKind.Unknown && latest is not null) { <span class="ciw-flag" title="No finished success/failure in the loaded history, so health cannot be judged">Not enough history</span> }
                @if (otherBranch is not null) { <span class="ciw-flag branch" title="Latest run was not on the default branch">@otherBranch</span> }
            </span>
        </div>
        <span class="ciw-wf-status"><StatusBadge State="latest?.State" Tooltip="@(latest is null ? "No runs in the loaded history" : $"Latest run #{latest.RunNumber}: {Fmt.StateLabel(latest.State)}")" /></span>
        <span class="ciw-runs">@runs.Count @(runs.Count == 1 ? "run" : "runs")</span>
        <span class="ciw-ago">@Fmt.Ago(latest?.SortTime, now)</span>
        <span class="ciw-actions">
            <button type="button" class="ciw-iconbtn" disabled="@(latest is null)" title="Quick inspect the latest run" aria-label="Quick inspect the latest run of @w.Name" data-action="inspect-latest"
                    @onclick="() => Ws.SelectRun(latest!)"><Icon Name="panel" Size="15" /></button>
            @if (url is not null)
            {
                <a class="ciw-iconbtn" href="@url" target="_blank" rel="noopener noreferrer" title="Open workflow on GitHub" aria-label="Open @w.Name on GitHub"><Icon Name="external" Size="15" /></a>
            }
        </span>
    </div>
    @if (open)
    {
        <WorkflowPreview Workflow="w" @key="w.Id" />
    }
</div>

@code {
    [CascadingParameter] internal RepositoryWorkspace Ws { get; set; } = default!;
    [Parameter, EditorRequired] public AssignedWorkflow Assigned { get; set; } = default!;

    private string? SafeUrl(string? u) =>
        !Ws.IsDemo && Uri.TryCreate(u, UriKind.Absolute, out var x) && x.Scheme == Uri.UriSchemeHttps && !x.Host.EndsWith(".invalid") ? x.ToString() : null;
}
