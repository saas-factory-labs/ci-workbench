@implements IAsyncDisposable
@inject CachedCi Provider
@inject CiwRoutes Routes
@inject IJSRuntime JS
@inject UiPreferences Prefs
@inject WorkspaceSignals Signals
@inject TimeProvider Time

<CascadingValue Value="this" IsFixed="true">
<section class="ciw-workspace" aria-busy="@(_loading ? "true" : "false")" data-view="@View">
    @if (_error is not null)
    {
        <div class="ciw-panel ciw-error" role="alert">
            <h3>Could not load @Repo</h3>
            <p>@_error</p>
            <button type="button" class="ciw-btn" @onclick="RetryAsync">Retry</button>
        </div>
    }
    else if (_workflows is null)
    {
        <div class="ciw-panel ciw-loading" role="status">
            <div class="ciw-skel w60"></div><div class="ciw-skel w40"></div><div class="ciw-skel w80"></div><div class="ciw-skel w60"></div>
            <p class="ciw-muted">@_stage</p>
        </div>
    }
    else
    {
        <header class="ciw-repo-head">
            <div class="ciw-repo-id">
                <h2 class="ciw-repo-title">@Repo.Name</h2>
                <span class="ciw-repo-owner">@Repo.Owner</span>
                @if (!string.IsNullOrWhiteSpace(Description)) { <p class="ciw-repo-desc">@Description</p> }
                <p class="ciw-meta" data-testid="repo-meta">
                    <span><strong>@_workflows.Count</strong> @(_workflows.Count == 1 ? "workflow" : "workflows")</span>
                    <span>Latest run <strong>@Fmt.Ago(_runs.FirstOrDefault()?.SortTime, Time.GetUtcNow())</strong>@(_summary.Active > 0 ? $" · {_summary.Active} active" : "")</span>
                    <span><Icon Name="branch" Size="13" /> <strong>@(DefaultBranch ?? MostActiveBranch)</strong> @(DefaultBranch is null ? "most active branch" : "default branch")</span>
                </p>
            </div>
            <div class="ciw-head-actions">@HeaderActions</div>
        </header>

        <div class="ciw-kpis" aria-label="Repository health" data-testid="kpis">
            <section class="ciw-kpi" aria-label="Success rate" data-kpi="success">
                <h3>Success rate</h3>
                <p class="ciw-kpi-value">@Fmt.Percent(_success.Rate)@if (_success.Trend is { } st) { <span class="ciw-trend @(st.Delta >= 0 ? "up" : "down")" title="Newer @st.RecentCount vs older @st.EarlierCount finished runs in the loaded window">@(st.Delta >= 0 ? "▲" : "▼") @Math.Abs(Math.Round(st.Delta)) pts</span>}</p>
                <div class="ciw-kpi-bar" role="img" aria-label="@Fmt.Percent(_success.Rate) of finished runs succeeded"><span style="width:@(Math.Round((_success.Rate ?? 0) * 100))%"></span></div>
                <p class="ciw-kpi-sub">@(_success.Rate is null ? "No finished runs yet" : $"{_success.Succeeded} of {_success.Succeeded + _success.Failed} finished runs") · last @_success.RunsInScope runs</p>
            </section>
            <section class="ciw-kpi" aria-label="Needs attention" data-kpi="attention">
                <h3>Needs attention</h3>
                <p class="ciw-kpi-value @(_attention.FailingNow > 0 ? "bad" : "good")">@_attention.FailingNow<span class="ciw-kpi-unit">@(_attention.FailingNow == 1 ? "workflow failing now" : "workflows failing now")</span></p>
                <p class="ciw-kpi-sub">@AttentionSub</p>
            </section>
            <section class="ciw-kpi" aria-label="Average duration" data-kpi="duration">
                <h3>Average duration</h3>
                <p class="ciw-kpi-value">@Fmt.Duration(_duration.Average)@if (_duration.Trend is { } dt) { <span class="ciw-trend neutral" title="Newer @dt.RecentCount vs older @dt.EarlierCount runs in the loaded window">@(dt.Delta >= 0 ? "▲" : "▼") @Fmt.Duration(TimeSpan.FromSeconds(Math.Abs(dt.Delta)))</span> }</p>
                <p class="ciw-kpi-sub">@(_duration.Samples == 0 ? "No completed runs yet" : $"{_duration.Samples} succeeded or failed runs · cancelled and active excluded")</p>
            </section>
        </div>

        @foreach (var w in AllWarnings)
        {
            <div class="ciw-notice warn" role="status">⚠ @w</div>
        }

        @if (AttentionList.Count > 0)
        {
            <div class="ciw-attn" role="status" data-testid="failure-banner">
                <span class="ciw-attn-icon" aria-hidden="true"><Icon Name="shield-alert" Size="16" /></span>
                <p class="ciw-attn-text">
                    <strong>@AttentionList.Count @(AttentionList.Count == 1 ? "workflow needs" : "workflows need") attention</strong>
                    <span class="ciw-attn-list">
                        @foreach (var w in AttentionList.Take(3))
                        {
                            <a class="ciw-attn-link" href="@Routes.Workflow(Repo, w.Id)" data-attn-workflow="@w.Id">@w.Name@if (HealthOf(w).Recurring) { <em>recurring</em> }</a>
                        }
                        @if (AttentionList.Count > 3) { <span class="ciw-muted">+@(AttentionList.Count - 3) more</span> }
                    </span>
                </p>
                <span class="ciw-attn-actions">
                    @if (_filter != "Attention") { <button type="button" class="ciw-btn sm" @onclick="@(() => SetFilter("Attention"))" data-action="show-attention">Show only these</button> }
                    @if (TotalSeries > 0 && View != WorkspaceView.Failures && OnViewFailures.HasDelegate)
                    {
                        <button type="button" class="ciw-btn sm" @onclick="() => OnViewFailures.InvokeAsync()" data-action="view-failures">Failure series</button>
                    }
                </span>
            </div>
        }

        <div class="ciw-toolbar">
            @if (ShowSearch)
            {
                <div class="ciw-searchbox">
                    <Icon Name="search" Size="16" />
                    <input type="search" placeholder="Filter workflows…" aria-label="Filter workflows and runs in this repository" title="Same filter as the top search box, scoped to this repository"
                           value="@Search" @oninput="e => Signals.SetSearch(e.Value?.ToString())" />
                </div>
            }
            <div class="ciw-chips" role="group" aria-label="Filter workflows by status">
                @foreach (var f in Filters)
                {
                    <button type="button" class="ciw-fchip @(_filter == f ? "on" : "") @(f == "Scheduled" ? "sep" : "")" aria-pressed="@(_filter == f ? "true" : "false")" @onclick="() => SetFilter(f)" data-filter="@f" title="@FilterHint(f)">
                        @switch (f)
                        {
                            case "Attention": <i class="dot red"></i> break;
                            case "Failed": <i class="dot red hollow"></i> break;
                            case "Running": <i class="dot blue"></i> break;
                            case "Succeeded": <i class="dot green"></i> break;
                            case "Scheduled": <Icon Name="clock" Size="13" /> break;
                        }
                        @FilterLabel(f) <span class="n">@CountFor(f)</span>
                    </button>
                }
            </div>
            <div class="ciw-toolbar-actions">
                @if (!Provider.IsDemo && !_series.Any() && !_analyzing && View == WorkspaceView.Groups && _workflows.Count > 3)
                {
                    <button type="button" class="ciw-btn sm" @onclick="FindRecurringAsync" data-action="analyze-all" title="Inspects the newest failed runs of up to 5 workflows (bounded API usage)">Find recurring failures</button>
                }
                @if (View == WorkspaceView.Groups)
                {
                    @if (AnyGroupOpen)
                    {
                        <button type="button" class="ciw-btn sm" @onclick="CollapseAll" data-action="collapse-all">Collapse all</button>
                    }
                    else
                    {
                        <button type="button" class="ciw-btn sm" @onclick="ExpandAll" data-action="expand-all">Expand all</button>
                    }
                }
            </div>
        </div>

        @if (_filter == "Attention")
        {
            <p class="ciw-scope" data-testid="attention-note">Attention view: @_attention.FailingNow failing now (recurring first), then @(_attention.Stale) stale failure@(_attention.Stale == 1 ? "" : "s") and @_attention.Recovered recovered. Healthy workflows are hidden; choose All to see them.</p>
        }

        @if (View == WorkspaceView.Groups)
        {
            @if (_resolvingGroups)
            {
                <div class="ciw-notice info" role="status">Resolving workflow groups from YAML comments (@_commentsDone/@_commentsTotal)…</div>
            }
            @if (_grouping.Groups.Count == 0 || !_grouping.AllWorkflows.Any(a => IsVisible(a.Workflow)))
            {
                <div class="ciw-empty">No workflows match the current search and filter.</div>
            }
            @foreach (var g in _grouping.Groups.Where(HasVisible))
            {
                <GroupNode Group="g" Depth="0" />
            }
            @if (_runs.Count >= MaxRuns)
            {
                <p class="ciw-footnote ciw-muted">Based on the @MaxRuns most recent runs. Open a workflow’s details to load its older runs.</p>
            }
        }
        else
        {
            @if (_analyzing) { <div class="ciw-notice info" role="status">Analyzing failures (bounded to the newest @FailureAnalyzer.DefaultMaxRuns failed runs per workflow)…</div> }
            @foreach (var w in _workflows.Where(w => _series.ContainsKey(w.Path) && _series[w.Path].Series.Count > 0))
            {
                var analysis = _series[w.Path];
                <section class="ciw-seriespanel standalone" aria-label="Failure analysis for @w.Name">
                    <header>
                        <span class="ciw-shield"><Icon Name="shield-alert" Size="18" /></span>
                        <strong>@w.Name</strong> <span class="ciw-mono ciw-muted ciw-path">@w.Path</span>
                        <span class="ciw-spacer"></span>
                        <span class="ciw-muted ciw-inspected">Inspected @analysis.RunsInspected of @analysis.RunsAvailable failed runs@(analysis.Truncated ? " · older failures not inspected" : "")</span>
                    </header>
                    <FailureSeriesList Repo="Repo" Series="analysis.Series" Runs="RunsFor(w)" OnRunSelected="Select" />
                </section>
            }
            @if (!_analyzing && TotalSeries == 0 && _series.Count > 0)
            {
                <div class="ciw-empty">No recurring failure series found in the loaded history.</div>
            }
            @if (!_analyzing && _series.Count == 0)
            {
                <div class="ciw-empty">
                    <p>No failure analysis has run yet.</p>
                    <button type="button" class="ciw-btn" @onclick="FindRecurringAsync" data-action="analyze-all">Find recurring failures</button>
                </div>
            }
        }
    }
</section>
</CascadingValue>

@code {
    private static readonly string[] Filters = ["All", "Attention", "Failed", "Running", "Succeeded", "Scheduled"];

    [Parameter, EditorRequired] public RepoRef Repo { get; set; }
    [Parameter] public WorkspaceView View { get; set; } = WorkspaceView.Groups;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? DefaultBranch { get; set; }
    [Parameter] public int MaxRuns { get; set; } = 100;
    [Parameter] public bool AutoRefresh { get; set; } = true;
    /// <summary>Hosts that already offer a global search (sharing <see cref="WorkspaceSignals"/>) can hide the workspace's own filter box.</summary>
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public TimeSpan RefreshInterval { get; set; } = TimeSpan.FromSeconds(30);
    [Parameter] public long? SelectedRunId { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public EventCallback<RunSelection> OnRunSelected { get; set; }
    [Parameter] public EventCallback OnViewFailures { get; set; }

    private IReadOnlyList<WorkflowInfo>? _workflows;
    private IReadOnlyList<WorkflowRunInfo> _runs = [];
    private readonly Dictionary<long, IReadOnlyList<WorkflowRunInfo>> _history = [];
    private readonly Dictionary<long, bool> _historyTruncated = [];
    private readonly Dictionary<long, IReadOnlyList<JobInfo>> _jobs = [];
    private readonly Dictionary<string, FailureAnalysis> _series = [];
    private readonly Dictionary<string, string> _analysisKey = [];
    private GroupConfig _config = new();
    private Dictionary<string, string?> _commentGroups = [];
    private GroupingResult _grouping = new([], []);
    private List<string> _warnings = [];
    private List<string> _configMessages = [];          // diagnostics of the central config file itself (with line numbers)

    /// <summary>Config problems first, then grouping checks against the real workflow list (only once comment groups finished resolving), then other notices.</summary>
    private IEnumerable<string> AllWarnings =>
        _configMessages.Concat(_resolvingGroups ? [] : _grouping.Warnings).Concat(_warnings).Distinct();
    private RunSummary _summary = new(0, 0, 0, 0);
    private string? _error;
    private string _stage = "Loading workflows…";
    private bool _loading, _analyzing, _resolvingGroups, _bestOpened, _scrollRestored;
    private int _commentsDone, _commentsTotal;
    private string _filter { get => Prefs.StatusFilter; set => Prefs.StatusFilter = value; }
    private DateTimeOffset _lastRefresh = DateTimeOffset.MinValue;
    private RepoRef _loadedRepo;
    private CancellationTokenSource _cts = new();
    private bool _timerStarted;

    private string? Search => Signals.SearchText;

    // ---- KPIs (definitions live in CIWorkbench.Core.Health.Kpis / WorkflowHealthAnalyzer) ----
    private SuccessRateKpi _success => Kpis.SuccessRate(_runs);
    private DurationKpi _duration => Kpis.AverageDuration(_runs);
    private AttentionKpi _attention => Kpis.Attention(_workflows!.Select(HealthOf));
    private string AttentionSub
    {
        get
        {
            var a = _attention;
            var recurring = _workflows!.Count(w => HealthOf(w) is { NeedsAttention: true, Recurring: true });
            var parts = new List<string>();
            if (recurring > 0) parts.Add($"{recurring} recurring");
            if (a.Recovered > 0) parts.Add($"{a.Recovered} recovered");
            if (a.Stale > 0) parts.Add($"{a.Stale} stale (older than {(int)WorkflowHealthAnalyzer.StaleAfter.TotalDays} days)");
            return parts.Count == 0 ? $"All {a.Total} workflows healthy" : string.Join(" · ", parts) + $" · of {a.Total} workflows";
        }
    }
    /// <summary>Workflows failing right now (never a stale or recovered one), recurring first.</summary>
    private List<WorkflowInfo> AttentionList => _workflows!.Where(w => HealthOf(w).NeedsAttention)
        .OrderBy(w => HealthOf(w).Priority).ThenBy(w => w.Name, StringComparer.OrdinalIgnoreCase).ToList();
    private int TotalSeries => _series.Values.Sum(a => a.Recurring.Count);
    private int DistinctFailedRuns => _series.Values.SelectMany(a => a.Recurring).SelectMany(s => s.Occurrences).Select(o => o.Run.Id).Distinct().Count();
    private string RangeText => _runs.Count == 0 ? "no runs" : $"{_runs.Min(r => r.SortTime).ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)} – {_runs.Max(r => r.SortTime).ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture)}";
    internal string ScopeText(RunSummary s) => $"{s.Succeeded} of {s.Succeeded + s.Failed} finished runs succeeded · loaded window {RangeText}";
    internal string GroupScope(WorkflowGroup g) => ScopeText(RunSummary.From(g.AllWorkflows.SelectMany(a => RunsFor(a.Workflow))));
    private string MostActiveBranch => _runs.GroupBy(r => r.Branch).OrderByDescending(g => g.Count()).Select(g => g.Key).FirstOrDefault() ?? "—";
    private string BannerWorkflows
    {
        get
        {
            var names = _workflows!.Where(w => _series.TryGetValue(w.Path, out var a) && a.Recurring.Count > 0).Select(w => w.Name).ToList();
            return names.Count == 1 ? $" in {names[0]}" : names.Count > 1 ? $" in {names.Count} workflows" : "";
        }
    }

    protected override void OnInitialized()
    {
        Signals.RefreshRequested += OnRefreshRequested;
        Signals.Changed += OnSignalsChanged;
        Prefs.Changed += OnSignalsChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedRepo.Equals(Repo) && _workflows is not null) return;
        _loadedRepo = Repo;
        if (Prefs.FilterRepo is not { } fr || !fr.Equals(Repo)) { Prefs.FilterRepo = Repo; _filter = "All"; }
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_workflows is null || _scrollRestored) return;
        _scrollRestored = true;
        try { await JS.InvokeVoidAsync("ciw.restoreScroll"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (JSDisconnectedException) { }
    }

    private void OnSignalsChanged() => InvokeAsync(StateHasChanged);
    private void OnRefreshRequested() => _ = InvokeAsync(() => RefreshAsync(manual: true));

    // ----------------------------------------------------------------------------------- loading

    private Task RetryAsync() { Provider.Clear(); return ReloadAsync(); }

    private async Task ReloadAsync()
    {
        _cts.Cancel(); _cts.Dispose(); _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        _workflows = null; _error = null; _runs = []; _series.Clear(); _analysisKey.Clear(); _history.Clear(); _historyTruncated.Clear(); _jobs.Clear();
        _warnings = []; _configMessages = []; _commentGroups = []; _config = new(); _grouping = new([], []); _bestOpened = false;
        _loading = true; _scrollRestored = false; _stage = "Loading workflows…"; Signals.ReportLoading(true);
        var repo = Repo;
        try
        {
            var wfTask = Provider.ListWorkflowsAsync(repo, ct);
            var runsTask = Provider.ListRecentRunsAsync(repo, MaxRuns, ct);
            var cfgTask = ReadConfigAsync(repo, ct);
            var wfs = await wfTask;
            _stage = "Loading recent runs…"; await InvokeAsync(StateHasChanged);
            _runs = await runsTask;
            var cfg = await cfgTask;
            _config = cfg.Result.Config;
            var source = cfg.SourcePath ?? GroupConfigContract.PreferredPath;
            _configMessages = cfg.Result.Diagnostics.Select(d => d.ToString(source)).ToList();
            _workflows = WithOrphans(wfs, _runs);
            Recompute();
            SeedSmallRepo();
            _lastRefresh = Time.GetUtcNow();
            Signals.ReportUpdated(_lastRefresh);
            _loading = false;
            await InvokeAsync(StateHasChanged);

            var groupsTask = ResolveCommentGroupsAsync(repo, ct);
            var analyze = Provider.IsDemo || _workflows.Count <= 3 || View == WorkspaceView.Failures;
            if (analyze) await AnalyzeCandidatesAsync(ct);
            await groupsTask;
            if (_workflows.Count > 3) await OpenBestGroupAsync(ct);
            StartPolling();
        }
        catch (OperationCanceledException) { }
        catch (CiProviderException ex) { _error = ex.Message; _loading = false; Signals.ReportLoading(false); }
        await InvokeAsync(StateHasChanged);
    }

    private Task<GroupConfigLoadResult> ReadConfigAsync(RepoRef repo, CancellationToken ct) => GroupConfigLoader.LoadAsync(Provider, repo, ct);

    /// <summary>Runs whose workflow is not in the workflow list still appear, under their own entry, so nothing silently disappears.</summary>
    private static IReadOnlyList<WorkflowInfo> WithOrphans(IReadOnlyList<WorkflowInfo> wfs, IReadOnlyList<WorkflowRunInfo> runs)
    {
        var known = wfs.Select(w => w.Id).ToHashSet();
        var orphans = runs.Where(r => !known.Contains(r.WorkflowId)).GroupBy(r => r.WorkflowId)
            .Select(g => new WorkflowInfo(g.Key, g.First().Name + " (not in workflow list)", string.IsNullOrEmpty(g.First().WorkflowPath) ? $"unknown/{g.Key}" : g.First().WorkflowPath, true, null));
        return [.. wfs, .. orphans];
    }

    private void Recompute()
    {
        _summary = RunSummary.From(_runs);
        // Grouping warnings are recomputed on every pass (e.g. after YAML-comment groups resolve), so stale ones never linger.
        _grouping = WorkflowGroupResolver.Resolve(_workflows!, _config, _commentGroups);
    }

    /// <summary>
    /// Comment-based groups need file contents. Fetch only workflows not already placed by central config, with bounded concurrency,
    /// after the first render, so the overview never waits on N file requests.
    /// </summary>
    private async Task ResolveCommentGroupsAsync(RepoRef repo, CancellationToken ct)
    {
        var pending = _workflows!.Where(w => !w.Path.StartsWith("dynamic/", StringComparison.Ordinal) && !_config.Groups.Any(g => g.Workflows.Any(p => WorkflowGroupResolver.PathMatches(p, w.Path)))).ToList();
        if (pending.Count == 0) return;
        _resolvingGroups = true; _commentsTotal = pending.Count; _commentsDone = 0;
        await InvokeAsync(StateHasChanged);
        using var gate = new SemaphoreSlim(4);
        try
        {
            await Task.WhenAll(pending.Select(async w =>
            {
                await gate.WaitAsync(ct);
                try
                {
                    var text = await Provider.GetFileAsync(repo, w.Path, ct);
                    lock (_commentGroups) _commentGroups[w.Path] = WorkflowGroupResolver.ExtractCommentGroup(text);
                }
                catch (CiProviderException) { /* unreadable workflow file: stays in the default group */ }
                finally { gate.Release(); Interlocked.Increment(ref _commentsDone); }
            }));
            if (ct.IsCancellationRequested || !repo.Equals(Repo)) return;
            Recompute();
        }
        catch (OperationCanceledException) { }
        finally { _resolvingGroups = false; await InvokeAsync(StateHasChanged); }
    }

    private bool HasRepoState => Prefs.ExpandedKeys.Any(k => k.StartsWith($"group|{Repo}|", StringComparison.Ordinal));

    /// <summary>Tiny repositories (3 workflows or fewer) open fully so the first screen shows value immediately.</summary>
    private void SeedSmallRepo()
    {
        if (_workflows!.Count > 3 || HasRepoState) return;
        foreach (var g in Walk(_grouping.Groups)) Prefs.SetExpanded(GroupKey(g), true);
        _bestOpened = true;
    }

    /// <summary>
    /// First visit to a larger repository: open only the group that holds the most urgent workflow (most recurring failures, else the first failing one).
    /// Workflows themselves stay collapsed. Never overrides state the user already has.
    /// </summary>
    private async Task OpenBestGroupAsync(CancellationToken ct)
    {
        if (_bestOpened || _workflows is null || View != WorkspaceView.Groups) return;
        _bestOpened = true;
        if (HasRepoState || _grouping.Groups.Count == 0) return;
        var best = _grouping.AllWorkflows.Select(a => a.Workflow)
            .OrderByDescending(w => _series.TryGetValue(w.Path, out var a) ? a.Recurring.Count : 0)
            .ThenByDescending(w => RunsFor(w).Count(r => r.State == RunState.Failure)).First();
        var assigned = _grouping.AllWorkflows.First(a => a.Workflow.Id == best.Id);
        var path = "";
        foreach (var part in assigned.GroupPath.Split('/')) { path = path.Length == 0 ? part : path + "/" + part; Prefs.SetExpanded($"group|{Repo}|{path}", true); }
        await InvokeAsync(StateHasChanged);
        await Task.CompletedTask;
    }

    private static IEnumerable<WorkflowGroup> Walk(IEnumerable<WorkflowGroup> gs) => gs.SelectMany(g => new[] { g }.Concat(Walk(g.Children)));

    // ----------------------------------------------------------------------------------- refresh

    private void StartPolling()
    {
        if (_timerStarted || !AutoRefresh || Provider.IsDemo) return;
        _timerStarted = true;
        _ = PollAsync(_cts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try { while (await timer.WaitForNextTickAsync(ct)) await InvokeAsync(() => RefreshAsync(manual: false)); }
        catch (OperationCanceledException) { }
        finally { _timerStarted = false; }
    }

    private async Task RefreshAsync(bool manual)
    {
        if (_workflows is null || _loading) return;
        if (manual && Time.GetUtcNow() - _lastRefresh < TimeSpan.FromSeconds(3)) return;   // throttle
        var ct = _cts.Token;
        try
        {
            Signals.ReportLoading(true);
            Provider.InvalidateRuns(Repo);
            _runs = await Provider.ListRecentRunsAsync(Repo, MaxRuns, ct);
            _workflows = WithOrphans(_workflows.Where(w => !w.Name.EndsWith("(not in workflow list)")).ToList(), _runs);
            Recompute();
            _lastRefresh = Time.GetUtcNow();
            Signals.ReportUpdated(_lastRefresh);
            foreach (var path in _series.Keys.ToList())
                if (_workflows.FirstOrDefault(w => w.Path == path) is { } w) await AnalyzeWorkflowAsync(w, ct, onlyIfChanged: true);
        }
        catch (OperationCanceledException) { }
        catch (CiProviderException ex) { _warnings = [.. _warnings.Where(x => !x.StartsWith("Refresh failed")), $"Refresh failed: {ex.Message}"]; Signals.ReportLoading(false); }
        await InvokeAsync(StateHasChanged);
    }

    // ----------------------------------------------------------------------------------- analysis

    private IEnumerable<WorkflowInfo> AnalysisCandidates() =>
        _workflows!.Select(w => (w, fails: RunsFor(w).Count(r => r.State == RunState.Failure))).Where(x => x.fails >= 2)
            .OrderByDescending(x => x.fails).Take(View == WorkspaceView.Failures ? 5 : 3).Select(x => x.w);

    private async Task AnalyzeCandidatesAsync(CancellationToken ct)
    {
        _analyzing = true; await InvokeAsync(StateHasChanged);
        try { foreach (var w in AnalysisCandidates()) { await AnalyzeWorkflowAsync(w, ct); await InvokeAsync(StateHasChanged); } }
        catch (OperationCanceledException) { }
        catch (CiProviderException ex) { _warnings.Add($"Failure analysis stopped: {ex.Message}"); }
        finally { _analyzing = false; }
    }

    private async Task FindRecurringAsync()
    {
        try { await AnalyzeCandidatesAsync(_cts.Token); } catch (OperationCanceledException) { }
        await InvokeAsync(StateHasChanged);
    }

    private async Task AnalyzeWorkflowAsync(WorkflowInfo w, CancellationToken ct, bool onlyIfChanged = false)
    {
        var runs = RunsFor(w);
        var key = string.Join(',', runs.Where(r => r.State == RunState.Failure).OrderByDescending(r => r.SortTime).Take(FailureAnalyzer.DefaultMaxRuns).Select(r => r.Id)) + "|" + (runs.FirstOrDefault()?.Id);
        if (onlyIfChanged && _analysisKey.TryGetValue(w.Path, out var old) && old == key) return;
        var truncated = _history.ContainsKey(w.Id) ? _historyTruncated.GetValueOrDefault(w.Id) : _runs.Count >= MaxRuns;
        _series[w.Path] = await new FailureAnalyzer(Provider).AnalyzeAsync(Repo, runs, truncated, FailureAnalyzer.DefaultMaxRuns, ct);
        _analysisKey[w.Path] = key;
    }

    // ----------------------------------------------------------------------------------- helpers

    internal IReadOnlyList<WorkflowRunInfo> RunsFor(WorkflowInfo w) =>
        _history.TryGetValue(w.Id, out var h) ? h : _runs.Where(r => r.WorkflowId == w.Id).OrderByDescending(r => r.SortTime).ToList();

    private RunState? LatestStateOrNull(WorkflowInfo w) => RunsFor(w).FirstOrDefault()?.State;
    internal RunState? LatestState(WorkflowInfo w) => LatestStateOrNull(w);

    /// <summary>Contextual health of one workflow: newest finished run on the default branch, recovery and recurrence. See <see cref="WorkflowHealthAnalyzer"/>.</summary>
    internal WorkflowHealth HealthOf(WorkflowInfo w) =>
        WorkflowHealthAnalyzer.Assess(RunsFor(w), DefaultBranch, _series.TryGetValue(w.Path, out var a) ? a.Recurring.Count > 0 : null, Time.GetUtcNow());

    internal string? NonDefaultBranch(WorkflowRunInfo? r) => r is not null && r.Branch != (DefaultBranch ?? MostActiveBranch) ? r.Branch : null;
    internal string? EffectiveDefaultBranch => DefaultBranch ?? MostActiveBranch;

    private bool MatchesFilter(WorkflowInfo w, string f)
    {
        if (f == "All") return true;
        var h = HealthOf(w);
        return f switch
        {
            "Attention" => h.Kind is HealthKind.FailingNow or HealthKind.Recovered,
            "Failed" => h.Kind == HealthKind.FailingNow,
            "Running" => RunsFor(w).Any(r => r.State.IsActive()),
            "Succeeded" => h.Kind is HealthKind.Healthy or HealthKind.Recovered,
            "Scheduled" => RunsFor(w).FirstOrDefault()?.Event == "schedule",
            _ => true,
        };
    }

    private int CountFor(string f) => f == "Attention" ? _workflows!.Count(w => HealthOf(w).NeedsAttention) : _workflows!.Count(w => MatchesFilter(w, f));

    private static string FilterLabel(string f) => f switch { "Attention" => "Needs attention", "Running" => "Active", "Scheduled" => "Scheduled runs", _ => f };
    private static string FilterHint(string f) => f switch
    {
        "All" => "Every workflow, in configured order",
        "Attention" => "Workflows whose newest finished run failed (recurring first), then stale failures and recovered workflows",
        "Failed" => "Newest finished run (success or failure) on the default branch failed",
        "Running" => "A run is queued or in progress",
        "Succeeded" => "Newest finished run on the default branch succeeded",
        _ => "Latest run was started by a schedule trigger (a trigger, not a result)",
    };

    private void SetFilter(string f) { _filter = f; }

    private bool MatchesSearch(WorkflowInfo w)
    {
        if (string.IsNullOrWhiteSpace(Search)) return true;
        return RunFiltering.WorkflowMatches(w, Search) || RunFiltering.Apply(RunsFor(w), new RunFilter(Search)).Count > 0;
    }

    internal bool IsVisible(WorkflowInfo w) => MatchesFilter(w, _filter) && MatchesSearch(w);
    internal bool HasVisible(WorkflowGroup g) => g.AllWorkflows.Any(a => IsVisible(a.Workflow));

    internal IReadOnlyList<WorkflowRunInfo> VisibleRuns(WorkflowInfo w)
    {
        var runs = RunsFor(w);
        if (string.IsNullOrWhiteSpace(Search) || RunFiltering.WorkflowMatches(w, Search)) return runs;
        return RunFiltering.Apply(runs, new RunFilter(Search));
    }

    internal string GroupKey(WorkflowGroup g) => $"group|{Repo}|{g.Path}";
    internal string WorkflowKey(WorkflowInfo w) => $"wf|{Repo}|{w.Path}|{w.Id}";
    internal bool Searching => !string.IsNullOrWhiteSpace(Search);

    private bool AnyGroupOpen => Walk(_grouping.Groups).Any(g => Prefs.IsExpanded(GroupKey(g)));
    private void ExpandAll() { foreach (var g in Walk(_grouping.Groups)) Prefs.SetExpanded(GroupKey(g), true); }
    private void CollapseAll()
    {
        foreach (var g in Walk(_grouping.Groups)) Prefs.SetExpanded(GroupKey(g), false);
        foreach (var w in _workflows!) Prefs.SetExpanded(WorkflowKey(w), false);
    }

    internal Task Select(RunSelection s) => OnRunSelected.InvokeAsync(s);
    internal Task SelectRun(WorkflowRunInfo r) => OnRunSelected.InvokeAsync(new RunSelection(Repo, r));

    /// <summary>Loads what an expanded workflow shows: jobs of the latest completed run and (if it keeps failing) a bounded failure analysis.</summary>
    private async Task EnsureWorkflowDetailsAsync(WorkflowInfo w, CancellationToken ct)
    {
        try
        {
            // The repo-wide window is shared by every workflow, so a busy repo can leave a daily scheduled workflow with one or two runs.
            // Selecting it fetches one bounded page of its own history.
            if (!_history.ContainsKey(w.Id) && _runs.Count >= MaxRuns && RunsFor(w).Count < 10)
            {
                var more = await Provider.ListWorkflowRunsAsync(Repo, w.Id, 30, ct);
                _history[w.Id] = more; _historyTruncated[w.Id] = more.Count >= 30;
            }
            var focus = PreviewRun(w);
            if (focus is not null && !_jobs.ContainsKey(focus.Id)) { _jobs[focus.Id] = await Provider.ListJobsAsync(Repo, focus.Id, ct); await InvokeAsync(StateHasChanged); }
            var active = RunsFor(w).FirstOrDefault(r => r.State.IsActive());
            if (active is not null && RunsFor(w).FirstOrDefault() == active) { _jobs[active.Id] = await Provider.ListJobsAsync(Repo, active.Id, ct); await InvokeAsync(StateHasChanged); }
            if (!_series.ContainsKey(w.Path) && RunsFor(w).Any(r => r.State == RunState.Failure))
            {
                _analyzing = true; await InvokeAsync(StateHasChanged);
                await AnalyzeWorkflowAsync(w, ct);
            }
        }
        catch (OperationCanceledException) { }
        catch (CiProviderException ex) { _warnings.Add($"{w.Name}: {ex.Message}"); }
        finally { _analyzing = false; }
    }

    /// <summary>The run the quick preview explains: the newest finished run on the failing verdict, otherwise the newest completed run.</summary>
    internal WorkflowRunInfo? PreviewRun(WorkflowInfo w)
    {
        var h = HealthOf(w);
        if (h.Kind == HealthKind.FailingNow && h.Verdict is { } v) return v;
        return RunsFor(w).FirstOrDefault(r => r.State.IsCompleted());
    }

    internal async Task ToggleWorkflow(WorkflowInfo w)
    {
        Prefs.Toggle(WorkflowKey(w));
        if (Prefs.IsExpanded(WorkflowKey(w))) await EnsureWorkflowDetailsAsync(w, _cts.Token);
    }

    internal async Task LoadHistoryAsync(WorkflowInfo w)
    {
        try
        {
            var all = await Provider.ListWorkflowRunsAsync(Repo, w.Id, 100, _cts.Token);
            _history[w.Id] = all; _historyTruncated[w.Id] = all.Count >= 100;
            _series.Remove(w.Path); _analysisKey.Remove(w.Path);
            if (RunsFor(w).Any(r => r.State == RunState.Failure)) await AnalyzeWorkflowAsync(w, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (CiProviderException ex) { _warnings.Add($"{w.Name}: {ex.Message}"); }
    }

    internal async Task AnalyzeNow(WorkflowInfo w)
    {
        _analyzing = true;
        try { await AnalyzeWorkflowAsync(w, _cts.Token); }
        catch (OperationCanceledException) { }
        catch (CiProviderException ex) { _warnings.Add($"{w.Name}: {ex.Message}"); }
        finally { _analyzing = false; }
    }

    // ----------------------------------------------------------------------------------- node helpers (used by GroupNode / WorkflowNode)

    internal bool IsDemo => Provider.IsDemo;
    internal CiwRoutes RouteTable => Routes;
    internal RepoRef RepoRef => Repo;
    internal UiPreferences Preferences => Prefs;
    internal TimeProvider Clock => Time;
    internal IReadOnlyList<WorkflowRunInfo> AllRuns => _runs;
    internal bool Analyzing => _analyzing;
    internal string StatusFilter => _filter;
    internal long? SelectedRun => SelectedRunId;
    internal bool TryGetAnalysis(string path, out FailureAnalysis analysis) => _series.TryGetValue(path, out analysis!);
    internal bool TryGetJobs(long runId, out IReadOnlyList<JobInfo> jobs) => _jobs.TryGetValue(runId, out jobs!);
    internal bool HasHistory(long workflowId) => _history.ContainsKey(workflowId);

    internal bool GroupOpen(WorkflowGroup g) => Prefs.IsExpanded(GroupKey(g)) || Searching || _filter == "Attention";
    internal int VisibleCount(WorkflowGroup g) => g.AllWorkflows.Count(a => IsVisible(a.Workflow));
    internal int GroupFailing(WorkflowGroup g) => g.AllWorkflows.Count(a => HealthOf(a.Workflow).NeedsAttention);
    internal int GroupRecovered(WorkflowGroup g) => g.AllWorkflows.Count(a => HealthOf(a.Workflow).Kind == HealthKind.Recovered);

    /// <summary>Configured order everywhere, except the attention view which ranks by <see cref="WorkflowHealth.Priority"/> inside each group.</summary>
    internal IEnumerable<AssignedWorkflow> VisibleWorkflows(WorkflowGroup g)
    {
        var list = g.Workflows.Where(a => IsVisible(a.Workflow));
        return _filter == "Attention" ? list.OrderBy(a => HealthOf(a.Workflow).Priority).ThenBy(a => a.Workflow.Name, StringComparer.OrdinalIgnoreCase) : list;
    }
    internal bool WfOpen(WorkflowInfo w) => Prefs.IsExpanded(WorkflowKey(w));
    internal void ToggleGroup(WorkflowGroup g) => Prefs.Toggle(GroupKey(g));
    internal bool IsGroupVisible(WorkflowGroup g) => HasVisible(g);
    internal bool IsWorkflowVisible(WorkflowInfo w) => IsVisible(w);

    public async ValueTask DisposeAsync()
    {
        Signals.RefreshRequested -= OnRefreshRequested;
        Signals.Changed -= OnSignalsChanged;
        Prefs.Changed -= OnSignalsChanged;
        _cts.Cancel(); _cts.Dispose();
        await ValueTask.CompletedTask;
    }
}
