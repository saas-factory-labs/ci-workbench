<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Only the three embeddable libraries opt in to packing (see src/CIWorkbench.{Core,GitHub,Components}). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Shared by the three packages. They are versioned together; bump here and nowhere else. -->
  <PropertyGroup>
    <CIWorkbenchVersion>0.1.0-preview.1</CIWorkbenchVersion>
  </PropertyGroup>
</Project>
